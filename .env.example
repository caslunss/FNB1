# Somente servidor. Cadastre os valores na Vercel; nunca use VITE_ para segredos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BRAPI_TOKEN=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SANDBOX=false
# Impostos: chave de servidor Supabase (nunca a publishable).
SUPABASE_SECRET_KEY=
# Alternativa legada a SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=
IBPT_TOKEN=
IBPT_CNPJ=
TAX_TIME_ZONE=America/Sao_Paulo
# Domínio próprio opcional, incluindo https://, sem caminho.
# Domínios de deploy Vercel são obtidos das variáveis VERCEL_* automaticamente.
APP_ORIGIN=
